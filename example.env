# API Configuration
# Point this to your deployed backend server in production. 
# In development, if left blank, the app will automatically connect to port 3001 on the current hostname.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# App URL Configuration
# The base URL where this frontend application is hosted (used for generating shareable links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
